{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "nodenext",
    "lib": ["es2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@borrowbox/contracts": ["./libs/contracts/src/index.ts"],
      "@borrowbox/testing": ["./libs/testing/src/index.ts"],
      "@borrowbox/messaging": ["./libs/messaging/src/index.ts"],
      "@borrowbox/media": ["./libs/media/src/index.ts"],
      "@borrowbox/outbox": ["./libs/outbox/src/index.ts"],
      "@borrowbox/auth": ["./libs/auth/src/index.ts"]
    },
    "types": ["node"],
    "isolatedModules": true
  },
  "exclude": ["node_modules", "tmp"]
}
