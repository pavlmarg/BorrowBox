# Local development only. Copy to infra/.env and change the values.
# infra/.env is gitignored — never commit real credentials.

# --- Postgres (superuser, used only for init and admin) ---
POSTGRES_USER=borrowbox_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=borrowbox

# --- One login role per service (ADR-0002) ---
IDENTITY_DB_PASSWORD=change-me-identity
CATALOG_DB_PASSWORD=change-me-catalog
BOOKINGS_DB_PASSWORD=change-me-bookings
PAYMENTS_DB_PASSWORD=change-me-payments
MESSAGING_DB_PASSWORD=change-me-messaging
NOTIFICATIONS_DB_PASSWORD=change-me-notifications
REVIEWS_DB_PASSWORD=change-me-reviews

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=borrowbox
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq

# --- Redis ---
REDIS_PASSWORD=change-me-redis

# --- Object storage (SeaweedFS locally, Cloudflare R2 in production) ---
S3_ACCESS_KEY_ID=borrowbox-dev
S3_SECRET_ACCESS_KEY=change-me-s3-secret
S3_BUCKET=borrowbox-media

# --- Host ports (optional). Change these if the defaults clash with
# something already running on your machine (e.g. a local Postgres). ---
# POSTGRES_PORT=5432
# RABBITMQ_PORT=5672
# RABBITMQ_UI_PORT=15672
# REDIS_PORT=6379
# S3_PORT=8333
# SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
