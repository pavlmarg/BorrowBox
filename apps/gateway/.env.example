# API gateway — local development only.
#   cp apps/gateway/.env.example apps/gateway/.env
# apps/gateway/.env is gitignored; never commit real credentials.

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
# Which proxies may set X-Forwarded-For (rate limits key on the client IP).
# loopback = Angular dev proxy / Caddy on this host. Caddy in Docker Compose:
# loopback,172.16.0.0/12 (or its network's subnet). Never trust everyone.
# TRUST_PROXY=loopback

# Identity's TCP endpoint (ADR-0005); same as IDENTITY_PORT in apps/identity/.env.
IDENTITY_HOST=127.0.0.1
IDENTITY_PORT=4001

# Catalog's TCP endpoint; same as CATALOG_PORT in apps/catalog/.env.
CATALOG_HOST=127.0.0.1
CATALOG_PORT=4002

# REDIS_PASSWORD from infra/.env.
REDIS_URL=redis://:change-me-redis@localhost:6379

CORS_ORIGINS=http://localhost:4200
WEB_APP_URL=http://localhost:4200

# Signs the Google sign-in cookie. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=

# Same JWT_PUBLIC_KEY / JWT_KEY_ID as Identity (never the private key).
JWT_KEY_ID=
JWT_PUBLIC_KEY=

# Google sign-in (optional): the same client id as Identity. The secret stays in Identity.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback

# Swagger UI at http://localhost:3000/api/docs
API_DOCS=true
