# Catalog service — local development only.
#   cp apps/catalog/.env.example apps/catalog/.env
# apps/catalog/.env is gitignored; never commit real credentials.

# Role catalog_svc; password = CATALOG_DB_PASSWORD in infra/.env.
DATABASE_URL=postgres://catalog_svc:change-me-catalog@localhost:5432/borrowbox
# RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS from infra/.env.
RABBITMQ_URL=amqp://borrowbox:change-me-rabbitmq@localhost:5672

# Gateway -> Catalog TCP (ADR-0005). Use 0.0.0.0 inside Docker.
CATALOG_HOST=127.0.0.1
CATALOG_PORT=4002

# Dev convenience; production runs `npx nx run catalog:migrate` instead.
DB_MIGRATIONS_RUN=true

# The same JWT_KEY_ID and JWT_PUBLIC_KEY as in apps/identity/.env.
# Catalog only verifies tokens: never give it JWT_PRIVATE_KEY.
JWT_KEY_ID=
JWT_PUBLIC_KEY=
