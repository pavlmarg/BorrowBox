# Payments service — local development only.
#   cp apps/payments/.env.example apps/payments/.env
# apps/payments/.env is gitignored; never commit real credentials.

# Role payments_svc; password = PAYMENTS_DB_PASSWORD in infra/.env.
DATABASE_URL=postgres://payments_svc:change-me-payments@localhost:5432/borrowbox
# RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS from infra/.env.
RABBITMQ_URL=amqp://borrowbox:change-me-rabbitmq@localhost:5672

# Gateway -> Payments TCP (ADR-0005). Use 0.0.0.0 inside Docker.
PAYMENTS_HOST=127.0.0.1
PAYMENTS_PORT=4005

# Dev convenience; production runs `npx nx run payments:migrate` instead.
DB_MIGRATIONS_RUN=true

# The same JWT_KEY_ID and JWT_PUBLIC_KEY as in apps/identity/.env.
JWT_KEY_ID=
JWT_PUBLIC_KEY=

# Stripe, TEST MODE ONLY (a live key stops the service from starting).
# Dashboard (test mode) > Developers > API keys > Secret key.
STRIPE_SECRET_KEY=sk_test_replace_me
# `stripe listen` prints one signing secret (whsec_…) for both endpoints, so
# locally both values are the same. In a deployment each webhook endpoint
# has its own (README: "Payments and Stripe").
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
# Country of new lenders' Stripe accounts.
STRIPE_ACCOUNT_COUNTRY=GR

# The PWA's origin: Stripe sends lenders back to /settings/payouts on it.
WEB_BASE_URL=http://localhost:4200
