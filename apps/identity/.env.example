# Identity service — local development only.
#   cp apps/identity/.env.example apps/identity/.env
# apps/identity/.env is gitignored; never commit real credentials.

# Role identity_svc; password = IDENTITY_DB_PASSWORD in infra/.env.
DATABASE_URL=postgres://identity_svc:change-me-identity@localhost:5432/borrowbox
# RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS from infra/.env.
RABBITMQ_URL=amqp://borrowbox:change-me-rabbitmq@localhost:5672

# Gateway -> Identity TCP (ADR-0005). Use 0.0.0.0 inside Docker.
IDENTITY_HOST=127.0.0.1
IDENTITY_PORT=4001

# Dev convenience; production runs `npx nx run identity:migrate` instead.
DB_MIGRATIONS_RUN=true

# Paste the output of `node tools/gen-jwt-keys.mjs`.
# JWT_PRIVATE_KEY belongs to Identity only; never give it to another service.
JWT_KEY_ID=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Google sign-in (optional; disabled unless both are set). Create a "Web
# application" OAuth client in Google Cloud Console with the redirect URI
# http://localhost:4200/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Account-security emails (ADR-0016). Mailpit from infra/docker-compose.yml
# catches them locally: http://localhost:8025. Empty SMTP_HOST disables
# sending (each email is skipped with a warning).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BorrowBox <no-reply@borrowbox.localhost>
# The PWA's origin, for links in emails.
WEB_BASE_URL=http://localhost:4200
