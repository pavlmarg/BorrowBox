# Bookings service — local development only.
#   cp apps/bookings/.env.example apps/bookings/.env
# apps/bookings/.env is gitignored; never commit real credentials.

# Role bookings_svc; password = BOOKINGS_DB_PASSWORD in infra/.env.
DATABASE_URL=postgres://bookings_svc:change-me-bookings@localhost:5432/borrowbox
# RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS from infra/.env.
RABBITMQ_URL=amqp://borrowbox:change-me-rabbitmq@localhost:5672

# Gateway -> Bookings TCP (ADR-0005). Use 0.0.0.0 inside Docker.
BOOKINGS_HOST=127.0.0.1
BOOKINGS_PORT=4003

# Dev convenience; production runs `npx nx run bookings:migrate` instead.
DB_MIGRATIONS_RUN=true

# The same JWT_KEY_ID and JWT_PUBLIC_KEY as in apps/identity/.env.
# Bookings only verifies tokens: never give it JWT_PRIVATE_KEY.
JWT_KEY_ID=
JWT_PUBLIC_KEY=

# Expiry jobs (BullMQ). REDIS_PASSWORD (and REDIS_PORT, if set) from infra/.env.
REDIS_URL=redis://:change-me-redis@localhost:6379
