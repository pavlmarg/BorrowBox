# Notifications service — local development only.
#   cp apps/notifications/.env.example apps/notifications/.env
# apps/notifications/.env is gitignored; never commit real credentials.

# Role notifications_svc; password = NOTIFICATIONS_DB_PASSWORD in infra/.env.
DATABASE_URL=postgres://notifications_svc:change-me-notifications@localhost:5432/borrowbox
# RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS from infra/.env.
RABBITMQ_URL=amqp://borrowbox:change-me-rabbitmq@localhost:5672

# Gateway -> Notifications TCP (ADR-0005). Use 0.0.0.0 inside Docker.
NOTIFICATIONS_HOST=127.0.0.1
NOTIFICATIONS_PORT=4004

# Dev convenience; production runs `npx nx run notifications:migrate` instead.
DB_MIGRATIONS_RUN=true

# The same JWT_KEY_ID and JWT_PUBLIC_KEY as in apps/identity/.env.
JWT_KEY_ID=
JWT_PUBLIC_KEY=

# SMTP (ADR-0016): Mailpit in dev (UI http://localhost:8025). Empty SMTP_HOST
# disables sending.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BorrowBox <no-reply@borrowbox.localhost>

# The PWA's origin, for links in emails.
WEB_BASE_URL=http://localhost:4200
